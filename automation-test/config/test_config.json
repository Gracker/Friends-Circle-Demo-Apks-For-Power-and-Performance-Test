{
    "version": "1.0.0",
    "description": "自动化测试配置",
    "device": {
        "wait_after_install_ms": 2000,
        "wait_after_launch_ms": 3000,
        "wait_after_swipe_ms": 500
    },
    "scrolling_test": {
        "enabled": true,
        "warmup_runs": 1,
        "iterations": 3,
        "swipe_count": 20,
        "swipe_duration_ms": 300,
        "swipe_start_y_ratio": 0.7,
        "swipe_end_y_ratio": 0.3,
        "settle_time_before_test_ms": 1000,
        "settle_time_after_test_ms": 1000,
        "fps_sample_window_frames": 120,
        "test_apps": [
            "aosp-performance",
            "compose",
            "webview",
            "gl-map"
        ],
        "test_load_types": [
            "minimal",
            "medium",
            "heavy"
        ]
    },
    "launch_test": {
        "enabled": true,
        "iterations": 5,
        "clear_cache_before_test": false,
        "wait_after_force_stop_ms": 1000,
        "wait_after_launch_ms": 3000,
        "test_apps": [
            "launch-aosp",
            "launch-compose",
            "launch-webview",
            "launch-gl",
            "launch-game"
        ],
        "test_flavors": [
            "light",
            "medium",
            "heavy"
        ]
    },
    "switch_test": {
        "enabled": true,
        "iterations": 3,
        "wait_after_main_launch_ms": 2000,
        "wait_after_switch_ms": 1500,
        "test_apps": [
            "switch-aosp",
            "switch-webview",
            "switch-flutter"
        ],
        "test_load_combinations": [
            "pure",
            "self_medium",
            "self_heavy",
            "heavy_heavy"
        ]
    },
    "output": {
        "results_dir": "results",
        "report_format": [
            "json",
            "markdown",
            "html"
        ],
        "include_raw_data": true,
        "include_device_info": true
    },
    "thresholds": {
        "fps": {
            "excellent": 115,
            "good": 90,
            "acceptable": 60,
            "poor": 30
        },
        "janky_percent": {
            "excellent": 1,
            "good": 5,
            "acceptable": 10,
            "poor": 20
        },
        "launch_time_ms": {
            "excellent": 300,
            "good": 500,
            "acceptable": 1000,
            "poor": 2000
        },
        "switch_time_ms": {
            "excellent": 100,
            "good": 200,
            "acceptable": 500,
            "poor": 1000
        }
    }
}