<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- OpenGL ES 2.0 requirement -->
    <uses-feature android:glEsVersion="0x00020000" android:required="true" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.GLMap">

        <activity
            android:name=".GLMapMainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity android:name=".MinimalLoadActivity" android:exported="false" android:theme="@style/Theme.GLMap.NoActionBar" />
        <activity android:name=".LightLoadActivity" android:exported="false" android:theme="@style/Theme.GLMap.NoActionBar" />
        <activity android:name=".MediumLoadActivity" android:exported="false" android:theme="@style/Theme.GLMap.NoActionBar" />
        <activity android:name=".HeavyLoadActivity" android:exported="false" android:theme="@style/Theme.GLMap.NoActionBar" />
        <activity android:name=".LightBetweenFramesActivity" android:exported="false" android:theme="@style/Theme.GLMap.NoActionBar" />
        <activity android:name=".MediumBetweenFramesActivity" android:exported="false" android:theme="@style/Theme.GLMap.NoActionBar" />
        <activity android:name=".HeavyBetweenFramesActivity" android:exported="false" android:theme="@style/Theme.GLMap.NoActionBar" />
        <activity android:name=".LightMixedActivity" android:exported="false" android:theme="@style/Theme.GLMap.NoActionBar" />
        <activity android:name=".MediumMixedActivity" android:exported="false" android:theme="@style/Theme.GLMap.NoActionBar" />
        <activity android:name=".HeavyMixedActivity" android:exported="false" android:theme="@style/Theme.GLMap.NoActionBar" />
        <activity android:name=".LongFrameActivity" android:exported="false" android:theme="@style/Theme.GLMap.NoActionBar" />

    </application>

</manifest>

