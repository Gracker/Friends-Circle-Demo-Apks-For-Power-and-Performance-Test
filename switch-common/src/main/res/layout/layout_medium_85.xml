<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@android:color/white"
        android:elevation="2dp"
        android:padding="16dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <ImageView
                android:id="@+id/avatar_85"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_alignParentStart="true"
                android:background="#505050"
                android:scaleType="centerCrop" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_toEndOf="@id/avatar_85"
                android:layout_marginStart="12dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/name_85"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="User Name 85"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/status_85"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Status message for user 85"
                    android:textSize="12sp"
                    android:textColor="#888888" />

            </LinearLayout>

            <ImageView
                android:id="@+id/more_85"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:background="#EEEEEE" />

        </RelativeLayout>

        <TextView
            android:id="@+id/content_85"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="This is the content text for medium item 85. It contains multiple lines of text to simulate real content."
            android:textSize="14sp"
            android:lineSpacingMultiplier="1.2" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/like_85"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Like"
                android:gravity="center"
                android:padding="8dp" />

            <TextView
                android:id="@+id/comment_85"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Comment"
                android:gravity="center"
                android:padding="8dp" />

            <TextView
                android:id="@+id/share_85"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Share"
                android:gravity="center"
                android:padding="8dp" />

        </LinearLayout>

    </LinearLayout>

</FrameLayout>
