<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 添加网络访问权限，WebView需要 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />

    <application
        android:name=".WebViewApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@style/Theme.HighPerformanceFriendsCircle">

        <!-- 主Activity，用于选择不同负载级别 -->
        <activity
            android:name=".WebViewMainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 最轻负载Activity -->
        <activity
            android:name=".MinimalLoadWebViewActivity"
            android:exported="false"
            android:theme="@style/Theme.HighPerformanceFriendsCircle.NoActionBar" />

        <!-- 轻负载Activity -->
        <activity
            android:name=".LightLoadWebViewActivity"
            android:exported="false"
            android:theme="@style/Theme.HighPerformanceFriendsCircle.NoActionBar" />

        <!-- 中等负载Activity -->
        <activity
            android:name=".MediumLoadWebViewActivity"
            android:exported="false"
            android:theme="@style/Theme.HighPerformanceFriendsCircle.NoActionBar" />

        <!-- 高负载Activity -->
        <activity
            android:name=".HeavyLoadWebViewActivity"
            android:exported="false"
            android:theme="@style/Theme.HighPerformanceFriendsCircle.NoActionBar" />

        <!-- 帧间轻负载Activity -->
        <activity
            android:name=".LightLoadBetweenFramesWebViewActivity"
            android:exported="false"
            android:theme="@style/Theme.HighPerformanceFriendsCircle.NoActionBar" />

        <!-- 帧间中负载Activity -->
        <activity
            android:name=".MediumLoadBetweenFramesWebViewActivity"
            android:exported="false"
            android:theme="@style/Theme.HighPerformanceFriendsCircle.NoActionBar" />

        <!-- 帧间高负载Activity -->
        <activity
            android:name=".HeavyLoadBetweenFramesWebViewActivity"
            android:exported="false"
            android:theme="@style/Theme.HighPerformanceFriendsCircle.NoActionBar" />

        <!-- 混合轻负载Activity -->
        <activity
            android:name=".LightMixedLoadWebViewActivity"
            android:exported="false"
            android:theme="@style/Theme.HighPerformanceFriendsCircle.NoActionBar" />

        <!-- 混合中负载Activity -->
        <activity
            android:name=".MediumMixedLoadWebViewActivity"
            android:exported="false"
            android:theme="@style/Theme.HighPerformanceFriendsCircle.NoActionBar" />

        <!-- 混合高负载Activity -->
        <activity
            android:name=".HeavyMixedLoadWebViewActivity"
            android:exported="false"
            android:theme="@style/Theme.HighPerformanceFriendsCircle.NoActionBar" />

    </application>

</manifest>
