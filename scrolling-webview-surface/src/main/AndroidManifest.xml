<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 添加网络访问权限，GeckoView需要 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />

    <application
        android:name=".GeckoViewApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@style/Theme.HighPerformanceFriendsCircle">

        <!-- 主Activity，用于选择不同负载级别 -->
        <activity
            android:name=".GeckoViewMainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 最轻负载Activity -->
        <activity
            android:name=".MinimalLoadGeckoViewActivity"
            android:exported="true"
            android:theme="@style/Theme.HighPerformanceFriendsCircle.NoActionBar" />

        <!-- 轻负载Activity -->
        <activity
            android:name=".LightLoadGeckoViewActivity"
            android:exported="true"
            android:theme="@style/Theme.HighPerformanceFriendsCircle.NoActionBar" />

        <!-- 中等负载Activity -->
        <activity
            android:name=".MediumLoadGeckoViewActivity"
            android:exported="true"
            android:theme="@style/Theme.HighPerformanceFriendsCircle.NoActionBar" />

        <!-- 高负载Activity -->
        <activity
            android:name=".HeavyLoadGeckoViewActivity"
            android:exported="true"
            android:theme="@style/Theme.HighPerformanceFriendsCircle.NoActionBar" />

        <!-- 帧间轻负载Activity -->
        <activity
            android:name=".LightLoadBetweenFramesGeckoViewActivity"
            android:exported="true"
            android:theme="@style/Theme.HighPerformanceFriendsCircle.NoActionBar" />

        <!-- 帧间中负载Activity -->
        <activity
            android:name=".MediumLoadBetweenFramesGeckoViewActivity"
            android:exported="true"
            android:theme="@style/Theme.HighPerformanceFriendsCircle.NoActionBar" />

        <!-- 帧间高负载Activity -->
        <activity
            android:name=".HeavyLoadBetweenFramesGeckoViewActivity"
            android:exported="true"
            android:theme="@style/Theme.HighPerformanceFriendsCircle.NoActionBar" />

        <!-- 混合轻负载Activity -->
        <activity
            android:name=".LightMixedLoadGeckoViewActivity"
            android:exported="true"
            android:theme="@style/Theme.HighPerformanceFriendsCircle.NoActionBar" />

        <!-- 混合中负载Activity -->
        <activity
            android:name=".MediumMixedLoadGeckoViewActivity"
            android:exported="true"
            android:theme="@style/Theme.HighPerformanceFriendsCircle.NoActionBar" />

        <!-- 混合高负载Activity -->
        <activity
            android:name=".HeavyMixedLoadGeckoViewActivity"
            android:exported="true"
            android:theme="@style/Theme.HighPerformanceFriendsCircle.NoActionBar" />

    </application>

</manifest>

